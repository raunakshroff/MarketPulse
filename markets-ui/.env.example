# Copy to .env for local development (.env itself is gitignored).
# Base URL of the stock-discovery service the UI reads from.
# src/api/client.ts falls back to this same value if the variable is unset.
VITE_API_BASE_URL=http://localhost:8082

# URL the profile menu's "Admin Console" link points at. This goes through markets-gateway's
# /admin/** route (trailing slash matters - see markets-admin's index.html) rather than
# markets-admin's own direct port, so the browser stays on one origin instead of the address
# bar jumping to a different port when navigating between the two screens.
# src/components/Layout.tsx falls back to this same value if the variable is unset.
VITE_ADMIN_URL=http://localhost:8080/admin/

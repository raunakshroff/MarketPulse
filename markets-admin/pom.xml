<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.marketpulse</groupId>
    <artifactId>markets-admin</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>markets-admin</name>
    <description>MarketPulse admin microservice - operations console for the other services</description>

    <properties>
        <java.version>25</java.version>
        <!-- springdoc 3.x is the Spring Boot 4 line (built against spring-boot-starter-parent 4.1.0);
             the 2.x line targets Spring Boot 3 and will not work here. -->
        <springdoc.version>3.1.0</springdoc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Spring Boot 4 defaults to Jackson 3 (tools.jackson); keep classic Jackson 2 for
             consistency with the sibling services, whose hand-written parsing uses its API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Swagger UI + OpenAPI 3 docs at /swagger-ui.html and /v3/api-docs -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- Deliberately no spring-boot-starter-data-jpa / postgresql: this service holds no state
             and must be able to start when the database is down, which is exactly when it is needed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WebMvcTest's auto-configuration import list references SecurityAutoConfiguration
             by class name even though this app doesn't use Spring Security; without this on
             the classpath, the test slice fails to load with a ClassNotFoundException. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
